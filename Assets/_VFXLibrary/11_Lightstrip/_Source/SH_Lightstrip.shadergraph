        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "CoreGradient",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 StepUV = floor(UV*10)/10;\nfloat xCoord = lerp(StepUV.x,UV.x,Mode)/10;\nOut = StepUV.y + xCoord;\nGridsSeed = StepUV.y + StepUV.x/10;"
}

